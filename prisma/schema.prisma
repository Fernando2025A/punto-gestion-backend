generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(uuid())
  username         String          @unique
  email            String?         @unique
  password         String?         // Opcional: nulo si provider es GOOGLE
  provider         AuthProvider    @default(LOCAL)
  emailVerified    Boolean         @default(false)

  stockAlertAt     Int             @default(10)             // Nivel de stock para alertas (opcional)
  expireAlertAt    Int             @default(30)             // Días antes de la expiración para alertas (opcional)

  isTemporaly       Boolean         @default(false)         // Indica si es un usuario temporal (ej: invitado)
  expiresAt         DateTime?                               // Fecha de expiración del usuario temporal (opcional)
  // Relaciones del sistema de inventario
  inventory        Inventory?
  movements        MovementHistory[]

  // Relación con tokens de seguridad / sesión
  tokens           UserToken[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model UserToken {
  id        String    @id @default(uuid())
  token     String    @unique
  type      TokenType
  userId    String
  expiresAt DateTime

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model Inventory {
  id         Int               @id @default(autoincrement())
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  movements  MovementHistory[]
  suppliers  Supplier[]        // 👈 Relación con los proveedores del inventario
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  price         Float
  purchasePrice Float?
  stock         Int

  category      Category
  expirationDate DateTime?     // 👈 Opcional: obligatorio en la lógica si es "FOOD"

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  inventoryId   Int
  inventory     Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  // Relación Opcional con Supplier
  supplierId    Int?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  movements     MovementHistory[]
}

model Supplier {
  id          Int       @id @default(autoincrement())
  name        String
  contact     String?   // Teléfono, email o contacto principal
  
  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  
  products    Product[] // Un proveedor puede tener muchos productos

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, inventoryId]) // Evita proveedores duplicados en el mismo inventario
}

//enum para categorias de productos:
enum Category {
  ELECTRONICS
  CLOTHING
  FOOD
  BOOKS
  FURNITURE
  TOYS
  SPORTS
  OTHERS
}

// Nuevo enum para los tipos de acciones
enum MovementType {
  CREATE_PRODUCT   // Creación de producto
  UPDATE_PRODUCT   // Edición general del producto (nombre, precio, categoría)
  STOCK_ENTRY      // Entrada de stock (compras, ajustes positivos)
  STOCK_EXIT       // Salida de stock (ventas, mermas, pérdidas)
  DELETE_PRODUCT   // Eliminación de producto (opcional)
}

model MovementHistory {
  id          Int          @id @default(autoincrement())
  
  type        MovementType
  quantity    Int?         // Cantidad ingresada/retirada (aplica para STOCK_ENTRY y STOCK_EXIT)
  previousStock Int?       // Stock que había ANTES del movimiento
  newStock     Int?        // Stock que quedó DESPUÉS del movimiento
  
  reason      String?      // Razón o nota opcional (ej: "Ajuste de inventario", "Merma", "Venta #102")
  details     Json?        // Útil para guardar cambios en edicion (ej: { oldPrice: 10, newPrice: 12 })

  createdAt   DateTime     @default(now())

  // Relaciones
  inventoryId Int
  inventory   Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  // Relación opcional con Product: 
  // Se deja opcional u omitida por si el producto se elimina en el futuro.
  productId   Int?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Relación con el usuario que ejecutó la acción
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}