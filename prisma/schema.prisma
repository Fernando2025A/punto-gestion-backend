generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(uuid())
  username        String            @unique
  email           String?           @unique
  password        String?
  provider        AuthProvider      @default(LOCAL)
  emailVerified   Boolean           @default(false)

  stockAlertAt    Int               @default(10)
  expireAlertAt   Int               @default(30)

  imageUrl        String?

  isTemporaly     Boolean           @default(false)
  expiresAt       DateTime?

  // Relaciones
  // 1. Negocios de los que es dueño directo
  ownedBusinesses Business[]        @relation("BusinessOwner")

  activeBusinessId Int
  
  // 2. Negocios donde trabaja (incluye su propio negocio y los de otros)
  employments     BusinessEmployee[]

  movements       MovementHistory[]
  tokens          UserToken[]

  createdInvites BusinessInvite[]

  sales Sale[]
  purchases Purchase[]
  expenses  Expense[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model UserToken {
  id        String    @id @default(uuid())
  token     String    @unique
  type      TokenType
  userId    String
  expiresAt DateTime

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])

  createdAt DateTime @default(now())
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model PlanLimit {
  id        Int       @id @default(autoincrement())

  planId    Int
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  type      LimitType
  value     Int?

  @@unique([planId, type])
}

enum LimitType {
  PRODUCTS
  EMPLOYEES
  MOVEMENTS
  IMAGES
  SUPPLIERS
  SALES
  PURCHASES
  EXPENSES
  INVITATIONS
}

model PlanPermission {
  id         Int        @id @default(autoincrement())

  planId     Int
  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  permission Permission

  @@unique([planId, permission])
}

model Plan {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?

  price       Decimal  @db.Decimal(10,2)

  businesses  Business[]

  limits      PlanLimit[]
  permissions PlanPermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Business {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String?

  ownerId     String
  owner       User     @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  planId      Int      @default(1)
  plan        Plan     @relation(fields: [planId], references: [id])
  planExpiresAt DateTime?

  employees   BusinessEmployee[]
  invites     BusinessInvite[]
  inventory   Inventory?

  sales       Sale[]
  purchases   Purchase[]
  expenses    Expense[]
  businessUsage BusinessUsage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessUsage {
  id         Int      @id @default(autoincrement())

  businessId Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type       UsageType
  value      Int      @default(0)

  periodStart DateTime
  periodEnd   DateTime

  @@unique([businessId, type, periodStart])
  @@index([businessId])
}

enum UsageType {
  MOVEMENTS
  IMAGES
  SALES
  PURCHASES
  EXPENSES
  INVITATIONS
}

model BusinessInvite {
  id          Int          @id @default(autoincrement())
  code        String       @unique // Ej: "INV-8921" (6 a 8 caracteres alfanuméricos)
  
  role        EmployeeRole @default(EMPLOYEE) // Rol que se le asignará a quien use el código
  
  expiresAt   DateTime     // 👈 Fecha y hora límite de validez
  maxUses     Int          @default(1)      // Límite de personas que pueden usar el código (ej: 1 o 5 personas)
  usedCount   Int          @default(0)

  // Relación con el Negocio que invita
  businessId  Int
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Opcional: Saber qué usuario/administrador creó la invitación
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  
  createdAt   DateTime     @default(now())

  @@index([code])
}

enum EmployeeRole {
  OWNER
  ADMIN
  CASHIER    // Cajero (solo ventas)
  STOCKER    // Encargado de inventario
  EMPLOYEE   // General
}

model BusinessEmployee {
  id          Int          @id @default(autoincrement())
  
  role        EmployeeRole

  permissions Permission[]
  isActive    Boolean      @default(true) // Si se desactiva, no puede entrar más a este negocio

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId  Int
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, businessId]) // Un usuario no puede estar duplicado en el mismo negocio
  @@index([businessId])
  @@index([userId])
}

enum Permission {
  // ==========================
  // PRODUCTOS
  // ==========================
  VIEW_PRODUCT
  CREATE_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT

  // ==========================
  // STOCK
  // ==========================
  REGISTER_STOCK_ENTRY
  REGISTER_STOCK_EXIT
  ADJUST_STOCK
  VIEW_MOVEMENTS

  // ==========================
  // CATEGORÍAS
  // ==========================
  VIEW_CATEGORIES
  CREATE_CATEGORIES
  UPDATE_CATEGORIES
  DELETE_CATEGORIES

  // ==========================
  // PROVEEDORES
  // ==========================
  VIEW_SUPPLIERS
  CREATE_SUPPLIERS
  UPDATE_SUPPLIERS
  DELETE_SUPPLIERS

  // ==========================
  // REPORTES
  // ==========================
  VIEW_REPORTS
  EXPORT_REPORTS_PDF
  EXPORT_REPORTS_EXCEL

  // ==========================
  // DASHBOARD
  // ==========================
  VIEW_DASHBOARD
  VIEW_FINANCIAL_SUMMARY

  // ==========================
  // EMPLEADOS
  // ==========================
  VIEW_EMPLOYEES
  CREATE_EMPLOYEES
  UPDATE_EMPLOYEES
  DELETE_EMPLOYEES

  MANAGE_EMPLOYEE_PERMISSIONS
  MANAGE_EMPLOYEE_ROLES

  // ==========================
  // INVITACIONES
  // ==========================
  CREATE_INVITATIONS
  DELETE_INVITATIONS
  VIEW_INVITATIONS

  // ==========================
  // CONFIGURACIÓN
  // ==========================
  VIEW_SETTINGS
  UPDATE_SETTINGS

  // ==========================
  // NEGOCIO
  // ==========================
  UPDATE_BUSINESS
  DELETE_BUSINESS

  // ==========================
  // PERFIL
  // ==========================
  UPDATE_PROFILE
  CHANGE_PASSWORD

  // ==========================
  // PREMIUM
  // ==========================
  MANAGE_SUBSCRIPTION

  // ==========================
  // GASTOS
  // ==========================
  CREATE_EXPENSE
}

model Inventory {
  id          Int               @id @default(autoincrement())
  
  // Ahora el inventario pertenece a un Business en lugar de a un User directamente
  businessId  Int               @unique
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  products    Product[]
  movements   MovementHistory[]
  suppliers   Supplier[]
}

model Product {
  id            Int           @id @default(autoincrement())
  name          String
  price         Decimal       @db.Decimal(10,2)
  purchasePrice Decimal       @db.Decimal(10,2)
  stock         Int
  minimumStock  Int?

  imageUrl      String?

  expireAlertAt Int           @default(30)

  category       Category
  expirationDate DateTime?     // 👈 Opcional: obligatorio en la lógica si es "FOOD"

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  inventoryId   Int
  inventory     Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  // Relación Opcional con Supplier
  supplierId    Int?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  movements     MovementHistory[]

  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@index([inventoryId])
}

model Supplier {
  id          Int       @id @default(autoincrement())
  name        String
  contact     String?   // Teléfono, email o contacto principal
  
  inventoryId Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  
  products    Product[] // Un proveedor puede tener muchos productos
  purchases   Purchase[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, inventoryId]) // Evita proveedores duplicados en el mismo inventario
  @@index([inventoryId])
}

//enum para categorias de productos:
enum Category {
  ELECTRONICS
  CLOTHING
  FOOD
  BOOKS
  FURNITURE
  TOYS
  SPORTS
  OTHERS
}

// Nuevo enum para los tipos de acciones
enum MovementType {
  CREATE_PRODUCT   // Creación de producto
  UPDATE_PRODUCT   // Edición general del producto (nombre, precio, categoría)
  STOCK_ENTRY      // Entrada de stock (compras, ajustes positivos)
  STOCK_EXIT       // Salida de stock (ventas, mermas, pérdidas)
  DELETE_PRODUCT   // Eliminación de producto (opcional)
}

// Enum para tipificar los motivos específicos de la salida/entrada de stock
enum MovementReason {
  // Motivos de Salida (STOCK_EXIT)
  SALE          // Venta de producto
  WASTE         // Merma / Desperdicio / Vencimiento
  DAMAGED       // Producto dañado o roto
  LOSS          // Pérdida / Robo / Faltante de inventario
  INTERNAL_USE  // Uso interno del negocio
  
  // Motivos de Entrada (STOCK_ENTRY)
  PURCHASE      // Compra a proveedor
  RETURN        // Devolución de cliente
  ADJUSTMENT    // Ajuste positivo de inventario
}

model MovementHistory {
  id            Int            @id @default(autoincrement())
  
  type          MovementType
  reason        MovementReason? // 👈 Ahora es un Enum
  notes         String?        // 👈 Campo de texto opcional para detalles extras

  quantity      Int?
  previousStock Int?
  newStock      Int?
  details       Json?

  createdAt     DateTime       @default(now())

  // Relaciones
  inventoryId   Int
  inventory     Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  productId     Int?
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([inventoryId, createdAt])
  @@index([reason])
}

model Sale {
  id          Int       @id @default(autoincrement())

  businessId  Int
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  subtotal    Decimal   @db.Decimal(12, 2)
  discount    Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)

  status      SaleStatus @default(COMPLETED)

  paymentMethod PaymentMethod

  items       SaleItem[]

  occurredAt  DateTime @default(now())
  createdAt   DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, occurredAt])
  @@index([userId])
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

model SaleItem {
  id          Int       @id @default(autoincrement())

  saleId      Int
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Snapshot de lo que ocurrió en ese momento
  productName String

  quantity    Int

  unitPrice   Decimal   @db.Decimal(12, 2)
  unitCost    Decimal   @db.Decimal(12, 2)

  subtotal    Decimal   @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  TRANSFER
  OTHER
}

model Purchase {
  id          Int       @id @default(autoincrement())

  businessId  Int
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  supplierId  Int?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  subtotal    Decimal   @db.Decimal(12, 2)
  total       Decimal   @db.Decimal(12, 2)

  items       PurchaseItem[]

  occurredAt  DateTime @default(now())

  createdAt   DateTime  @default(now())

  @@index([businessId, occurredAt])
  @@index([businessId, createdAt])
}

model PurchaseItem {
  id          Int       @id @default(autoincrement())

  purchaseId  Int
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId   Int?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String

  quantity    Int

  unitCost    Decimal   @db.Decimal(12, 2)

  subtotal    Decimal   @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

model Expense {
  id          Int       @id @default(autoincrement())

  businessId  Int
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  category    ExpenseCategory

  description String?

  amount      Decimal   @db.Decimal(12, 2)

  createdAt   DateTime  @default(now())
  occurredAt  DateTime  @default(now())

  @@index([businessId, occurredAt])
  @@index([businessId, createdAt])
  @@index([businessId, category])
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  TRANSPORT
  MARKETING
  TAXES
  MAINTENANCE
  OTHER
}